---
interface Props {
  label: string;
  title: string;
  description?: string;
}
const { label, title, description } = Astro.props;
---

<div class="section-header" data-reveal>
  <span class="section-label">{label}</span>
  <h2 class="section-title">{title}</h2>
  {description && <p class="section-desc">{description}</p>}
</div>
